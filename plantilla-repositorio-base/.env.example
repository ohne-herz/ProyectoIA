# Copia este archivo como ".env" y completa los valores reales ahi.
# El archivo ".env" nunca se sube al repositorio (esta excluido en .gitignore).

# Llave de API de Gemini (Google AI Studio). Sin ella, el servicio corre en modo --simulado.
GEMINI_API_KEY=tu_llave_aqui

# Opcionales (valores por defecto alineados con docs/decision-arquitectura.md)
# GEMINI_MODEL=gemini-3.1-flash-lite
